color-link default "#ffffff,none"
color-link line-number "#989898,none"
color-link current-line-number "bold #00d3d0,none"
color-link statusline "#000000,#79a8ff"
color-link selection "#000000,#535353"
# markdown text layers. `default` is intentionally NOT touched: normal markdown
# prose gets its color from the `md-normal` syntax group so other filetypes keep
# the stock white. Emphasis (bold / italic / bold-italic) is pinned to pure white
# so it pops against the #f2f2f2 body text.
color-link italic-text "italic #ffffff"
color-link bold-text "bold #ffffff"
color-link bold-italic "bold italic #ffffff"
color-link md-normal "#f2f2f2,none"
# emphasis delimiters (*, **, ***) -- dimmed so the markup recedes behind the
# emphasized text, which stays pure white (see italic/bold links above).
color-link emphasis-marker "#a8a8a8,none"
# markdown headers. h1 = bright white (#ffffff in wezterm) on an ANSI blue
# background that the patched micro build extends to the end of the row, no
# underline. h2 = bright blue text, underlined with the row fill extending to
# the end of the row. h3 = bright blue, underline only under the text.
# h4-h6 = bright blue, no underline. The patch copies fg/bg/underline from
# these links for its row fill, so text and fill always agree.
color-link headline "bold italic brightwhite,blue"
color-link headline-2 "bold italic underline brightblue"
color-link headline-3 "bold italic underline brightblue"
color-link headline-4-6 "bold italic brightblue"
# fenced code blocks + inline code: ANSI green
color-link code-inline "green,none"
color-link code-block "green,none"
# xml/html tag markup (<tag>, </tag>, <tag/>): ANSI bright blue
color-link xml-tag "brightblue,none"
# markdown table borders (pipes + separator-row - : _ runs): ANSI white
# (SGR 37, palette 7). Cell text is NOT painted here -- it keeps the normal
# prose color from the md-normal base layer (rules only match border chars).
color-link table-border "white,none"

color-link keyword "bold #feacd0,none"
color-link statement "bold #feacd0,none"
color-link type "#00c06f,none"
color-link constant "#b6a0ff,none"
color-link literal "#b6a0ff,none"
color-link string "#6ae4b9,none"
color-link stringescape "bold #fec43f,none"
color-link comment "italic #989898,none"
color-link preproc "#00d3d0,none"
color-link function "#79a8ff,none"
color-link special "#f78fe7,none"
color-link todo "bold #d0bc00,none"
color-link error "#ff5f59,none"
color-link diffadd "#6ae4b9,none"
color-link diffdelete "#ff5f59,none"
