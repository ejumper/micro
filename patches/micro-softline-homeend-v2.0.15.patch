+// vRowBounds returns the buffer locations of the start and the end
+// (exclusive) of the visual (soft-wrapped) row containing loc. When softwrap
+// is disabled it falls back to the logical line bounds, and the end of the
+// last row of a line is always the logical line end, so the bounds never
+// cross logical lines.
+//
+// A loc that sits exactly on a wrap boundary (end of row N == start of
+// row N+1) is resolved to the following row, matching how the softwrap
+// display maps locations. As a consequence EndOfLine from a boundary steps
+// to the end of the next visual row, so repeated End presses walk down the
+// wrapped rows of a logical line.
+func (h *BufPane) vRowBounds(loc buffer.Loc) (buffer.Loc, buffer.Loc) {
+	lineLen := util.CharacterCount(h.Buf.LineBytes(loc.Y))
+	if !h.Buf.Settings["softwrap"].(bool) {
+		return buffer.Loc{X: 0, Y: loc.Y}, buffer.Loc{X: lineLen, Y: loc.Y}
+	}
+	vloc := h.VLocFromLoc(loc)
+	start := h.LocFromVLoc(display.VLoc{SLoc: vloc.SLoc, VisualX: 0})
+	end := h.LocFromVLoc(display.VLoc{SLoc: display.SLoc{Line: vloc.Line, Row: vloc.Row + 1}, VisualX: 0})
+	return start, end
+}
+
+// vRowStart returns the buffer location of the first character of the
+// visual row containing loc. If loc is already at that row's start it
+// returns the start of the previous visual row instead, so repeated Home
+// presses walk up the rows — including across hard line breaks: at the
+// start of a logical line's first row it continues on the previous logical
+// line's last visual row. Falls back to column 0 when softwrap is disabled.
+func (h *BufPane) vRowStart(loc buffer.Loc) buffer.Loc {
+	if !h.Buf.Settings["softwrap"].(bool) {
+		if loc.X == 0 && loc.Y > 0 {
+			return buffer.Loc{X: 0, Y: loc.Y - 1}
+		}
+		return buffer.Loc{X: 0, Y: loc.Y}
+	}
+	vloc := h.VLocFromLoc(loc)
+	start := h.LocFromVLoc(display.VLoc{SLoc: vloc.SLoc, VisualX: 0})
+	if loc.X == start.X {
+		if vloc.Row > 0 {
+			return h.LocFromVLoc(display.VLoc{SLoc: display.SLoc{Line: vloc.Line, Row: vloc.Row - 1}, VisualX: 0})
+		}
+		// At the start of the logical line's first row: continue on the
+		// previous logical line's last visual row.
+		if loc.Y > 0 {
+			prevEol := buffer.Loc{X: util.CharacterCount(h.Buf.LineBytes(loc.Y - 1)), Y: loc.Y - 1}
+			lastRow := h.VLocFromLoc(prevEol).Row
+			return h.LocFromVLoc(display.VLoc{SLoc: display.SLoc{Line: loc.Y - 1, Row: lastRow}, VisualX: 0})
+		}
+	}
+	return start
+}
+
+// vRowEnd returns the buffer location of the end (exclusive) of the visual
+// row containing loc. When loc is already at the end of its logical line's
+// last visual row it returns the end of the first visual row of the next
+// logical line instead, so repeated End presses walk down the rows —
+// including across hard line breaks. Falls back to the logical line end
+// when softwrap is disabled.
+func (h *BufPane) vRowEnd(loc buffer.Loc) buffer.Loc {
+	_, end := h.vRowBounds(loc)
+	if loc == end && loc.Y < h.Buf.LinesNum()-1 {
+		// Already at the end of the last visual row of this logical line:
+		// continue on the first visual row of the next logical line.
+		_, nextEnd := h.vRowBounds(buffer.Loc{X: 0, Y: loc.Y + 1})
+		return nextEnd
+	}
+	return end
+}
+
+// vRowStartOfText returns the location of the first non-whitespace
+// character of the visual row containing loc (the row start itself when the
+// row does not start with whitespace). Falls back to the first
+// non-whitespace character of the logical line when softwrap is disabled.
+func (h *BufPane) vRowStartOfText(loc buffer.Loc) buffer.Loc {
+	start, end := h.vRowBounds(loc)
+	line := h.Buf.LineBytes(loc.Y)
+	x := start.X
+	i := 0
+	for len(line) > 0 && i < end.X {
+		r, _, size := util.DecodeCharacter(line)
+		line = line[size:]
+		if i >= start.X {
+			if !util.IsWhitespace(r) {
+				return buffer.Loc{X: i, Y: loc.Y}
+			}
+			x = i + 1
+		}
+		i++
+	}
+	return buffer.Loc{X: x, Y: loc.Y}
+}
+
