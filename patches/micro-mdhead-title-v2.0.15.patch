+
+// mdHeaderLevel returns the ATX heading level (1-6) of a markdown buffer
+// line, or 0 if the line is not a heading. A heading needs at least one
+// character of content after the "# " marker.
+func mdHeaderLevel(line []byte) int {
+	n := 0
+	for n < len(line) && line[n] == '#' {
+		n++
+	}
+	if n >= 1 && n <= 6 && n < len(line) && line[n] == ' ' &&
+		n+1 < len(line) && line[n+1] != ' ' {
+		return n
+	}
+	return 0
+}
+
+// isMdH1Line reports whether buffer line y is a markdown h1 heading that
+// should get the full-row underline fill. The syntax engine's group for the
+// first character must be "headline" — this excludes lines inside fenced
+// code blocks, which the regex alone cannot do.
+func isMdH1Line(b *buffer.Buffer, y int) bool {
+	if ft, ok := b.Settings["filetype"].(string); !ok || ft != "markdown" {
+		return false
+	}
+	if mdHeaderLevel(b.LineBytes(y)) != 1 {
+		return false
+	}
+	group, ok := b.Match(y)[0]
+	return ok && group.String() == "headline"
+}
+
+// mdH1FillStyle is the style used to pad the rest of an h1 line so its
+// underline spans the full editor width. The foreground color follows the
+// "headline" colorscheme group, defaulting to blue (ANSI SGR 34).
+func mdH1FillStyle() tcell.Style {
+	style := config.DefStyle.Underline(true)
+	if s, ok := config.Colorscheme["headline"]; ok {
+		fg, _, _ := s.Decompose()
+		style = style.Foreground(fg)
+	} else {
+		style = style.Foreground(tcell.ColorBlue)
+	}
+	return style
+}
