+
+// mdHeaderLevel returns the ATX heading level (1-6) of a markdown buffer
+// line, or 0 if the line is not a heading. A heading needs at least one
+// character of content after the "# " marker.
+func mdHeaderLevel(line []byte) int {
+	n := 0
+	for n < len(line) && line[n] == '#' {
+		n++
+	}
+	if n >= 1 && n <= 6 && n < len(line) && line[n] == ' ' &&
+		n+1 < len(line) && line[n+1] != ' ' {
+		return n
+	}
+	return 0
+}
+
+// mdFillGroupFor returns the colorscheme group whose style should fill the
+// rest of a markdown heading line so the fill spans the full editor width:
+// "headline" for h1 (blue background), "headline-2" for h2 (underline), or
+// "" for lines that get no fill. The syntax engine's group for the first
+// character must match the heading level — this excludes lines inside
+// fenced code blocks, which the regex alone cannot do.
+func mdFillGroupFor(b *buffer.Buffer, y int) string {
+	if ft, ok := b.Settings["filetype"].(string); !ok || ft != "markdown" {
+		return ""
+	}
+	level := mdHeaderLevel(b.LineBytes(y))
+	if level < 1 || level > 2 {
+		return ""
+	}
+	want := "headline"
+	if level == 2 {
+		want = "headline-2"
+	}
+	group, ok := b.Match(y)[0]
+	if !ok || group.String() != want {
+		return ""
+	}
+	return want
+}
+
+// mdFillStyle is the style used to pad the rest of a heading line. It
+// copies the foreground, background and underline flag from the heading's
+// colorscheme group, so text and fill always agree — changing the
+// color-link changes both. A group missing from the colorscheme falls back
+// to the default style (no visible fill).
+func mdFillStyle(group string) tcell.Style {
+	style := config.DefStyle
+	if s, ok := config.Colorscheme[group]; ok {
+		fg, bg, attrs := s.Decompose()
+		style = style.Foreground(fg).Background(bg)
+		if attrs&tcell.AttrUnderline != 0 {
+			style = style.Underline(true)
+		}
+	}
+	return style
+}
