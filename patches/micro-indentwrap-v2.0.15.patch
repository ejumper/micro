diff --git a/internal/display/softwrap.go b/internal/display/softwrap.go
index 1460f88..ebbbf4e 100644
--- a/internal/display/softwrap.go
+++ b/internal/display/softwrap.go
@@ -67,6 +67,23 @@ type SoftWrap interface {
 	LocFromVLoc(vloc VLoc) buffer.Loc
 }
 
+func (w *BufWindow) wrapIndentWidth(line []byte, tabsize int) int {
+	if !w.Buf.Settings["indentwrap"].(bool) || w.bufWidth <= 1 {
+		return 0
+	}
+
+	leadingws := util.GetLeadingWhitespace(line)
+	indent := util.StringWidth(leadingws, len(leadingws), tabsize)
+	return util.Min(indent, w.bufWidth-1)
+}
+
+func wrapRowStart(row, indent int) int {
+	if row == 0 {
+		return 0
+	}
+	return indent
+}
