diff --git a/internal/display/statusline_truncate_test.go b/internal/display/statusline_truncate_test.go
new file mode 100644
index 0000000..ae469a6
--- /dev/null
+++ b/internal/display/statusline_truncate_test.go
@@ -0,0 +1,43 @@
+package display
+
+import (
+	"os"
+	"testing"
+)
+
+func TestTruncatePathHead(t *testing.T) {
+	home, err := os.UserHomeDir()
+	if err != nil || home == "" {
+		t.Skip("no home directory")
+	}
+	// With home = "/home/ejumps": long width 30, "~/a/bb/ccc/file.md" 18,
+	// "…/a/bb/ccc/file.md" 18, "…/bb/ccc/file.md" 16, "…/ccc/file.md" 13,
+	// "…/file.md" 9.
+	long := home + "/a/bb/ccc/file.md"
+
+	cases := []struct {
+		name string
+		path string
+		maxW int
+		want string
+	}{
+		{"already fits", "/a/b/file.md", 100, "/a/b/file.md"},
+		{"exact fit", "/a/b/file.md", 12, "/a/b/file.md"},
+		{"home collapse fits", long, 18, "~/a/bb/ccc/file.md"},
+		{"home collapse then drop", long, 17, "…/bb/ccc/file.md"},
+		{"drop to last dir", long, 15, "…/ccc/file.md"},
+		{"floor via loop", long, 9, "…/file.md"},
+		{"floor beats tiny max", long, 2, "…/file.md"},
+		{"floor beats zero max", long, 0, "…/file.md"},
+		{"single component", "file.md", 1, "file.md"},
+		{"relative drops", "bb/ccc/file.md", 11, "…/file.md"},
+		{"home-like prefix not collapsed", home + "2/x.md", 6, "…/x.md"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := truncatePathHead(c.path, c.maxW); got != c.want {
+				t.Errorf("truncatePathHead(%q, %d) = %q, want %q", c.path, c.maxW, got, c.want)
+			}
+		})
+	}
+}
