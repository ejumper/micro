+// statusGap returns the minimum number of cells kept between the left and the
+// right statusline content ("statuslinegap" option).
+func (s *StatusLine) statusGap() int {
+	gap := 8
+	switch v := s.win.Buf.Settings["statuslinegap"].(type) {
+	case int:
+		gap = v
+	case float64:
+		gap = int(v)
+	}
+	if gap < 0 {
+		gap = 0
+	}
+	return gap
+}
+
+// expandFormat expands all $() directives in fb via formatter, returning the
+// expanded text. If fb contains a $(filename) directive, fnStart and fnEnd are
+// the byte offsets of its (first) expansion in the result; otherwise both are
+// -1.
+func expandFormat(fb []byte, formatter func([]byte) []byte) ([]byte, int, int) {
+	var out []byte
+	fnStart, fnEnd := -1, -1
+	last := 0
+	for _, loc := range formatParser.FindAllIndex(fb, -1) {
+		out = append(out, fb[last:loc[0]]...)
+		repl := formatter(fb[loc[0]:loc[1]])
+		if bytes.Equal(fb[loc[0]+2:loc[1]-1], []byte("filename")) {
+			fnStart = len(out)
+			out = append(out, repl...)
+			fnEnd = len(out)
+		} else {
+			out = append(out, repl...)
+		}
+		last = loc[1]
+	}
+	out = append(out, fb[last:]...)
+	return out, fnStart, fnEnd
+}
+
+// strWidth returns the display width of a string with tabsize 1.
+func strWidth(str string) int {
+	return util.StringWidth([]byte(str), util.CharacterCount([]byte(str)), 1)
+}
+
+// truncatePathHead shortens a path to fit within maxW display cells while
+// keeping the tail of the path (the file name) readable. $HOME is collapsed
+// to "~" first, then the highest-level parent directories are dropped one at
+// a time, each drop marked with a leading ellipsis:
+//
+//	/home/user/a/b/c/file.md -> ~/a/b/c/file.md -> …/b/c/file.md -> …/c/file.md -> …/file.md
+//
+// "…/<basename>" is the floor: it is returned even when it still exceeds
+// maxW, so the statusline overflows rather than hiding the file name. Paths
+// that already fit, and single-component paths that cannot be shortened,
+// are returned unchanged.
+func truncatePathHead(path string, maxW int) string {
+	if strWidth(path) <= maxW {
+		return path
+	}
+
+	// Step 0: collapse $HOME to "~"
+	if home, err := os.UserHomeDir(); err == nil && home != "" {
+		if rest := strings.TrimPrefix(path, home); len(rest) < len(path) && (len(rest) == 0 || rest[0] == '/') {
+			path = "~" + rest
+			if strWidth(path) <= maxW {
+				return path
+			}
+		}
+	}
+
+	comps := strings.Split(path, "/")
+	if len(comps) < 2 {
+		// Single component: nothing to drop without hiding the name.
+		return path
+	}
+	for i := 1; i < len(comps); i++ {
+		cand := "…/" + strings.Join(comps[i:], "/")
+		if strWidth(cand) <= maxW {
+			return cand
+		}
+	}
+	// Floor: ellipsis plus the file name itself.
+	return "…/" + comps[len(comps)-1]
+}
